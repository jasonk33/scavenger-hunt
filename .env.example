# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL — Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Settings → API Keys → "Legacy anon, service_role API keys" tab → service_role
# Server-only. Bypasses RLS. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Same tab → anon.
#
# It MUST be the LEGACY anon key, which starts with "eyJ". Supabase Storage
# requires an Authorization header and requires it to be a JWT; the newer
# sb_publishable_... keys are not JWTs and fail with "Invalid Compact JWS".
# This one is handed to the browser on purpose — it is the public key.
SUPABASE_ANON_KEY=eyJ...

# Storage bucket for photos and video. Created by supabase/02-storage.sql.
SUPABASE_BUCKET=hunt

# Gate for the Judge and Admin screens. Not a security boundary — it stops a
# player from wandering in and approving their own submissions. If unset, both
# screens are open to anyone.
ORGANIZER_PIN=1234
